# =============================================
# BioMedSystem - Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# Used by docker-compose and deploy.sh.
#
# Usage:
#   Windows (PowerShell): copy .env.example .env
#   Linux:                cp .env.example .env

# --- Server ---
SERVER_PORT=8088

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/biomed?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONN_TIMEOUT=20000
DB_POOL_MAX_LIFETIME=1200000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3000ms
REDIS_POOL_MAX=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=3000ms

# --- Application ---
APP_UPLOAD_MAX_BYTES=268435456
APP_UPLOAD_DIR=data/uploads
APP_MAP_CACHE_DIR=data/map-cache
APP_BACKUP_DIR=data/backup
APP_CORS_ORIGINS=http://localhost:8080,http://localhost:8088,http://localhost:5173
APP_SESSION_TTL_MINUTES=480
APP_PASSWORD_MIN_LENGTH=8

# --- SQL Init Mode (always for dev, never for prod) ---
SQL_INIT_MODE=always

# --- Integration ---
INTEGRATION_MASTER_KEY=change-this-integration-master-key
